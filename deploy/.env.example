# Image references. Use immutable tags or image digests for a reproducible deployment.
TAPCANVAS_WEB_IMAGE=ghcr.io/your-org/tapcanvas-web:2026.07.23
TAPCANVAS_API_IMAGE=ghcr.io/your-org/tapcanvas-api:2026.07.23
TAPCANVAS_AGENTS_BRIDGE_IMAGE=ghcr.io/your-org/tapcanvas-agents-bridge:2026.07.23
NEW_API_IMAGE=ghcr.io/your-org/tapcanvas-new-api:2026.07.23
TAPCANVAS_NEW_API_PATCH_IMAGE=ghcr.io/your-org/tapcanvas-new-api-patch:2026.07.23

# Public port of the Nginx web container.
WEB_PORT=8080
# Internal API origin consumed by the Web image. Docker Compose uses the service name;
# set this to Zeabur's private API hostname when deploying services individually.
API_UPSTREAM=http://api:8788

# Database identities. Generate unique values before the first deployment.
POSTGRES_DB=tapcanvas
POSTGRES_USER=tapcanvas
POSTGRES_PASSWORD=replace-with-a-long-random-password
NEW_API_POSTGRES_DB=tapcanvas_new_api

# Required production secrets. Do not use development defaults.
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_WORKER_TOKEN=replace-with-a-long-random-token
NEW_API_INTERNAL_TOKEN=replace-with-a-long-random-token
NEW_API_SESSION_SECRET=replace-with-a-long-random-secret
NEW_API_CRYPTO_SECRET=replace-with-a-long-random-secret

# Required for the agents bridge to call the configured model channel in new-api.
AGENTS_API_KEY=replace-with-your-new-api-access-token

# Optional integrations passed to API and agents bridge.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_URL=
# R2_PUBLIC_BASE_URL=
# RESEND_API_KEY=
# RESEND_FROM=
# AUTH_OTP_PEPPER=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_NOTIFY_URL=
